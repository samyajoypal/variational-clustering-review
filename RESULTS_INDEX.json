      "key": "nmi_arithmetic",
      "primary": false
    },
    {
      "definition": "Chance-adjusted mutual information with arithmetic normalization",
      "key": "ami_arithmetic",
      "primary": false
    },
    {
      "definition": "Unweighted mean class F1 under the accuracy-optimal map",
      "key": "mapped_macro_f1",
      "primary": false
    },
    {
      "definition": "Mean class recall under the same map",
      "key": "mapped_balanced_accuracy",
      "primary": false
    },
    {
      "definition": "Class purity of the clustering",
      "key": "homogeneity",
      "primary": false
    },
    {
      "definition": "Concentration of each class within clusters",
      "key": "completeness",
      "primary": false
    },
